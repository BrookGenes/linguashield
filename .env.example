# Copy to .env then fill in. Load with:  set -a; source .env; set +a
# General-purpose model you compare AGAINST (any OpenAI-compatible provider):
BASE_URL=https://api.openai.com/v1
BASE_API_KEY=put-key-here
BASE_MODEL=put-model-name-here

# YOUR Adaption-trained model, if served via an OpenAI-style API (check Adaption's AutoScientist page):
MINE_URL=
MINE_API_KEY=
MINE_MODEL=

# OR, if you downloaded weights instead:
LOCAL_MODEL_PATH=models/linguashield
